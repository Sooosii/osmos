# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example carries no secret and the README points at it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# yerel ayıklama çıktıları — tarayıcı aracının kaydettikleri ve elle alınan
# ekran görüntüleri. İşin kaydı değiller, depoda yerleri yok.
#
# Kalıp KÖKE bağlı (baştaki `/`): `public/` altındaki gerçek görseller etkilenmiyor.
# Tek tek ad yazmak bırakıldı — köke düşen her görsel geçici oluyor ve her yeni
# adlandırma (Screenshot_…, Item Not Found…) listeye bir satır daha ekletiyordu.
/.playwright-mcp/
/tmp/
/*.png
/*.jpeg
/*.jpg

# beyin fırtınası görsel sekmesinin mockup'ları — tartışmanın izi, işin kaydı değil
/.superpowers/

# B2B aday verisi — bu depo AÇIK ve bu dosyalar 735 işletmenin e-postası,
# Instagram hesabı ve puanı. Kural bugüne kadar yalnız akılda duruyordu ve
# `git add -A` bir kez hepsini sahneye aldı (leads.db, outreach.csv, dm-listesi);
# fark edilmeseydi açık depoya girecekti. Artık kural dosyada. Kod depoda,
# VERİ değil.
/leadgen/node_modules/
/leadgen/data/
/leadgen/**/*.db
/leadgen/**/*.csv
