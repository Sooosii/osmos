# OSMOS — environment
#
# Copy to `.env.local` if you need to override anything. Everything is
# optional: the site runs with none of these set.

# Absolute base URL, used by the sitemap, the hreflang links and the share
# images.
#
# Leave it unset and the site works out of the box:
#   · on the host, it reads the platform's own production URL
#   · locally, it falls back to http://localhost:3000
#
# Set it once a custom domain is in place — that is the only line that changes
# on the day the site gets its own address.
#
# NEXT_PUBLIC_SITE_URL=https://osmos.example

# VAPID public key — enables the NOTIFY button. Generate a pair with
# `npx web-push generate-vapid-keys`; the private half never goes here (it
# lives only in GitHub Actions secrets, where sending happens). Without this
# the button never renders and the site behaves as before.
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Push subscription store (Upstash Redis, REST). On Vercel these arrive by
# themselves when the Upstash integration is added; the UPSTASH_REDIS_REST_*
# names are read too. Without them /api/push answers 503 in production and
# falls back to an in-memory map in development.
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Accounts ---
#
# Postgres for accounts, profiles and top fours (Neon). On Vercel this arrives
# by itself when the Neon integration is added. Without it the account pages
# are unreachable; the rest of the site is untouched.
#
# DATABASE_URL=

# Signs the session cookie. Generate once with `openssl rand -base64 32`.
# Changing it signs everyone out.
#
# BETTER_AUTH_SECRET=

# Google sign-in (optional — email/password works without it).
# The redirect URI must be exactly <site>/api/auth/callback/google.
#
# The third variable is what makes the button appear. It is separate on
# purpose: the client cannot read GOOGLE_CLIENT_ID (no NEXT_PUBLIC_ prefix,
# and it should not have one), so without an explicit flag the button either
# renders always — failing for anyone who presses it before Google is set up —
# or never. Set all three together.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_ENABLED=1

# Transactional email: address confirmation and password reset. Nothing else
# is ever sent. Without a key the messages are printed to the server console
# in development.
#
# Measured, so nobody assumes otherwise: in production a failed send does NOT
# fail the sign-up. The account is created unverified and the error reaches
# only the server log, so the person sees success and waits. That is why the
# sign-in screen carries a "send the confirmation again" link.
#
# Deliverability needs a domain verified in Resend. Measured: from the shared
# onboarding@resend.dev sender, mail to the account owner lands in Gmail's spam
# folder, and mail to anyone else is refused outright with 403 — "you can only
# send testing emails to your own email address". Until a domain is verified,
# nobody but the owner can complete a sign-up.

# Shows the "sign in" invitation in the frame. Separate from everything above
# on purpose: the account layer can be complete and working while still not
# being ready to invite strangers — which is exactly the state before a domain
# is verified in Resend. Signed-in people always see their link; only the
# invitation to strangers is withheld. /signin keeps working by direct address.
#
# NEXT_PUBLIC_ACCOUNTS_ENABLED=1
#
# RESEND_API_KEY=
# MAIL_FROM="OSMOS <hello@your-domain>"
